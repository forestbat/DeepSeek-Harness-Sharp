<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dsh.Gui.ViewModels"
             xmlns:views="using:Dsh.Gui.Views"
             x:Class="Dsh.Gui.Views.HostPageView"
             x:DataType="vm:HostPageViewModel"
             x:CompileBindings="True"
             FontFamily="{DynamicResource Font.Ui}"
             FontSize="{DynamicResource FontSize.Body}">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:FilesViewModel">
      <views:FilesView />
    </DataTemplate>
    <DataTemplate DataType="vm:GitViewModel">
      <views:GitView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="12,10,12,0">
      <TextBlock Classes="Title" Text="{Binding Title}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" MinWidth="140" ItemsSource="{Binding MachineNames}" SelectedItem="{Binding Machine, Mode=TwoWay}"
                ToolTip.Tip="机器" />
      <TextBox Grid.Column="2" Classes="Mono" Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               IsReadOnly="{Binding IsPathReadOnly}" PlaceholderText="路径（~ 为该机器上的家目录）">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding PickAndOpenCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="3" Classes="Primary" Content="打开" Command="{Binding PickAndOpenCommand}" IsEnabled="{Binding !IsOpening}" />
    </Grid>
    <TextBlock Grid.Row="1" Classes="Tertiary" Margin="12" Text="{Binding Status}" TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <ContentControl Grid.Row="1" Content="{Binding Content}" />
  </Grid>
</UserControl>
