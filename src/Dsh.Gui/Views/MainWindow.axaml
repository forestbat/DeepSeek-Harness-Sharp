<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="using:Dsh.Gui.ViewModels"
        xmlns:views="using:Dsh.Gui.Views"
        x:Class="Dsh.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="DeepSeek Harness"
        Width="1400" Height="850" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource Brush.Bg.Window}">


  <Grid RowDefinitions="Auto,*">
    <Grid Name="TitleBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto"
          Height="34" Background="{DynamicResource Brush.Bg.Sidebar}" IsVisible="False"
          chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Image Grid.Column="0" Source="avares://Dsh.Gui/Assets/icon.png" Width="18" Height="18"
             Margin="10,0,8,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="DeepSeek Harness" Classes="Tertiary" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="TitleButton" Click="OnMinimizeClick" ToolTip.Tip="最小化"
              chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
        <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Minimize}" />
      </Button>
      <Button Grid.Column="3" Classes="TitleButton" Click="OnMaximizeClick" ToolTip.Tip="最大化/还原"
              chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
        <Path Classes="Icon" Width="12" Height="12" Data="{StaticResource Icon.Maximize}" />
      </Button>
      <Button Grid.Column="4" Classes="TitleButton close" Click="OnCloseClick" ToolTip.Tip="关闭"
              chrome:WindowDecorationProperties.ElementRole="CloseButton">
        <Path Classes="Icon" Width="12" Height="12" Data="{StaticResource Icon.Close}" />
      </Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">
      <views:SidebarView Grid.Column="0" Width="{DynamicResource Layout.SidebarWidth}"
                         IsVisible="{Binding IsSidebarVisible}" />
      <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border.Subtle}"
              IsVisible="{Binding IsSidebarVisible}" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Name="WorkspaceBar" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="56,8,16,0">
          <TextBlock Text="工作台" Classes="Title" VerticalAlignment="Center" IsVisible="{Binding IsDashboardPage}" />
          <Button Grid.Column="1" Classes="Chip" Command="{Binding OpenTerminalCommand}" ToolTip.Tip="打开当前机器的终端">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Terminal}" />
              <TextBlock Text="终端" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="Chip" Command="{Binding Workspace.Palette.ToggleCommand}" ToolTip.Tip="快速切换会话">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Search}" />
              <TextBlock Text="跳转到会话…" />
              <TextBlock Text="Ctrl+K" Classes="Tertiary" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Name="BellButton" Classes="Icon" Width="34" Height="30" ToolTip.Tip="通知">
            <Panel>
              <Path Classes="Icon" Width="18" Height="18" Data="{StaticResource Icon.Bell}" />
              <Border Classes="AttentionBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-10,0"
                      IsVisible="{Binding Workspace.Notifications.HasUnread}">
                <TextBlock Name="UnreadBadge" Text="{Binding Workspace.Notifications.BadgeText}" />
              </Border>
            </Panel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <views:NotificationPanelView DataContext="{Binding Workspace.Notifications}" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <ContentControl Grid.Row="1" Name="FleetSessionHost" Content="{Binding Workspace.ActiveSession}" IsVisible="{Binding IsFleetSessionPage}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:FleetSessionViewModel">
              <views:FleetSessionView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <ContentControl Grid.Row="1" Name="WorkspacePageHost" Content="{Binding Workspace.PageContent}" IsVisible="{Binding IsWorkspacePage}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:HostPageViewModel">
              <views:HostPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:MachinesViewModel">
              <views:MachinesView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <views:ChatView Grid.Row="1" IsVisible="{Binding IsChatPage}" />
        <ContentControl Grid.Row="1" Content="{Binding Page}" IsVisible="{Binding IsLazyPage}">
          <ContentControl.ContentTemplate>
            <views:PageTemplateSelector>
              <views:PageTemplateSelector.Dashboard>
                <DataTemplate x:CompileBindings="False">
                  <views:DashboardView DataContext="{Binding $parent[Window].DataContext.Workspace.Dashboard}" />
                </DataTemplate>
              </views:PageTemplateSelector.Dashboard>
              <views:PageTemplateSelector.Settings>
                <DataTemplate x:CompileBindings="False">
                  <views:SettingsPageView DataContext="{Binding $parent[Window].DataContext}" />
                </DataTemplate>
              </views:PageTemplateSelector.Settings>
              <views:PageTemplateSelector.Market>
                <DataTemplate x:CompileBindings="False">
                  <views:MarketPageView DataContext="{Binding $parent[Window].DataContext}" />
                </DataTemplate>
              </views:PageTemplateSelector.Market>
            </views:PageTemplateSelector>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <Button Classes="Icon" Width="28" Height="28" Margin="10,12,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Command="{Binding ToggleSidebarCommand}"
                IsVisible="{Binding !IsSidebarVisible}"
                ToolTip.Tip="展开左栏">
          <Path Classes="Icon" Data="{StaticResource Icon.Menu}" />
        </Button>
      </Grid>
    </Grid>

    <views:CommandPaletteView Grid.Row="0" Grid.RowSpan="2" Name="Palette" DataContext="{Binding Workspace.Palette}"
                              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Workspace.Palette.IsOpen}" ZIndex="30" />

    <ItemsControl Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,18,18" IsHitTestVisible="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastViewModel">
          <Border Background="{DynamicResource Brush.Bg.Card}"
                  BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadius.Card}"
                  Padding="12,10" Margin="0,8,0,0" MaxWidth="440">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="8" Height="8" Margin="0,5,0,0" VerticalAlignment="Top"
                       Fill="{DynamicResource Brush.Status.Error}" IsVisible="{Binding IsError}" />
              <Ellipse Width="8" Height="8" Margin="0,5,0,0" VerticalAlignment="Top"
                       Fill="{DynamicResource Brush.Status.Success}" IsVisible="{Binding IsSuccess}" />
              <StackPanel Spacing="2" MaxWidth="380">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" Classes="Secondary" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
