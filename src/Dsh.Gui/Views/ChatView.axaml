<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dsh.Gui.ViewModels"
             xmlns:views="using:Dsh.Gui.Views"
             xmlns:sys="using:System"
             x:Class="Dsh.Gui.Views.ChatView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True"
             FontFamily="{DynamicResource Font.Ui}">

  <UserControl.Resources>
    <views:PngToBitmapConverter x:Key="PngToBitmap" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Background="{DynamicResource Brush.Bg.Chat}">

    <Grid x:Name="ChatHeader" Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
          Classes="chatHeader" Classes.collapsed="{Binding !IsSidebarVisible}">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding SessionTitle}" Classes="Title" />
        <TextBlock Text="{Binding SessionSubtitle}" Classes="Tertiary" />
      </StackPanel>

      <Button Grid.Column="1" Classes="Chip" VerticalAlignment="Center" ToolTip.Tip="交互 preset">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Shield}" />
          <TextBlock Text="{Binding PresetLabel}" />
          <Path Classes="Icon" Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight" Opened="OnPresetFlyoutOpened">
            <ItemsControl ItemsSource="{Binding PresetItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PresetListItem">
                  <Button Classes="Ghost" Classes.selected="{Binding IsCurrent}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Click="OnPresetItemClick">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Flyout>
        </Button.Flyout>
      </Button>

      <Button Grid.Column="2" Classes="Chip" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="子代理">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Trace}" />
          <TextBlock Text="子代理" />
          <Border IsVisible="{Binding Subagents.HasNodes}" Padding="5,1" CornerRadius="999"
                  Background="{DynamicResource Brush.Accent.Soft}" VerticalAlignment="Center">
            <TextBlock Text="{Binding Subagents.Badge}" Classes="Tertiary" />
          </Border>
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight" Opened="OnSubagentFlyoutOpened">
            <StackPanel Width="330" Spacing="4">
              <TextBlock Text="当前会话没有子代理" Classes="Tertiary" IsVisible="{Binding !Subagents.HasNodes}" />
              <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Subagents.Nodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubagentNodeViewModel">
                      <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Click="OnSubagentItemClick">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <Border Width="{Binding Indent}" />
                          <TextBlock Grid.Column="1" Text="●" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.Status.Success}" IsVisible="{Binding IsLive}" />
                          <TextBlock Grid.Column="1" Text="○" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Classes="Tertiary" IsVisible="{Binding !IsLive}" />
                          <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModeLabel}" Classes="Tertiary" />
                            <TextBlock Text="▾" Classes="Tertiary" IsVisible="{Binding HasChildren}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <Button Grid.Column="3" Classes="Chip" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="会话模式">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Shield}" />
          <TextBlock Text="{Binding ModeLabel}" />
          <Path Classes="Icon" Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="标准模式（每次审批弹窗）" Command="{Binding SetModeCommand}" CommandParameter="standard" />
            <MenuItem Header="计划模式（/plan）" Command="{Binding SetModeCommand}" CommandParameter="plan" />
            <MenuItem Header="Full access（自动放行，黑名单仍生效）" Command="{Binding SetModeCommand}" CommandParameter="full" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>

      <Button Grid.Column="4" Classes="Ghost" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="会话日志">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Download}" />
          <TextBlock Text="Session log" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="导出会话日志（JSONL）" Command="{Binding ExportSessionLogCommand}" />
            <MenuItem Header="打开会话目录" Command="{Binding OpenSessionFolderCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="18,10,18,0">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Classes="Tab" Classes.selected="{Binding !IsTraceTab}" Command="{Binding ShowConversationCommand}">
          <TextBlock Text="对话" />
        </Button>
        <Button Classes="Tab" Classes.selected="{Binding IsTraceTab}" Command="{Binding ShowTraceCommand}">
          <TextBlock Text="轨迹" />
        </Button>
      </StackPanel>
      <ItemsControl Grid.Column="2" ItemsSource="{Binding TraceFilters}" IsVisible="{Binding IsTraceTab}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TraceFilterViewModel">
            <Button Classes="Chip" Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectTraceFilterCommand}"
                    CommandParameter="{Binding}">
              <TextBlock Text="{Binding Label}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border.Subtle}" />

    <ListBox Grid.Row="2" Name="MessageList" Classes="MessageList" IsVisible="{Binding !IsTraceTab}"
             ItemsSource="{Binding Messages}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MessageViewModel">
            <Border Classes="Msg" Classes.user="{Binding IsUser}" HorizontalAlignment="{Binding Align}">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Role}" Classes="Tertiary" IsVisible="{Binding HasRole}" />

                <TextBlock Text="{Binding Preview}" Classes="Secondary" IsVisible="{Binding ShowPreview}" />
                <Button Classes="Ghost" Padding="2,0" HorizontalAlignment="Left"
                        IsVisible="{Binding IsFoldable}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleMessageFoldCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding FoldLabel}" Classes="Tertiary" />
                </Button>

                <StackPanel Spacing="2" Margin="2,2,0,2" IsVisible="{Binding ShowSubagentStream}">
                  <ItemsControl ItemsSource="{Binding SubagentStream}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MessageViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                          <TextBlock Text="{Binding Role}" Classes="Tertiary" Margin="0,0,6,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Preview}" Classes="Secondary"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="Ghost" Padding="2,0" HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSubagentViewCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="打开只读视图 →" Classes="Tertiary" />
                  </Button>
                </StackPanel>
                <TextBlock Text="子代理暂无工具调用" Classes="Tertiary" IsVisible="{Binding ShowSubagentEmpty}" />

                <views:MarkdownView Text="{Binding Text}" IsVisible="{Binding ShowMarkdown}" />
                <views:DiffView Card="{Binding Diff}" IsVisible="{Binding ShowDiff}"
                                IsCardExpanded="{Binding IsDiffExpanded, Mode=TwoWay}" />
                <TextBlock Text="{Binding Text}" Classes="Body" IsVisible="{Binding ShowPlainBody}" />
                <TextBlock Text="{Binding Detail}" Classes="Body" IsVisible="{Binding ShowDetail}"
                           FontFamily="{DynamicResource Font.Mono}" />

                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowActions}">
                  <Button Classes="Icon" Width="26" Height="26" ToolTip.Tip="复制"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyMessageCommand}"
                          CommandParameter="{Binding}">
                    <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Copy}" />
                  </Button>
                  <Button Classes="Icon" Width="26" Height="26" ToolTip.Tip="有帮助"
                          Classes.selected="{Binding IsLiked}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LikeMessageCommand}"
                          CommandParameter="{Binding}">
                    <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.ThumbUp}" />
                  </Button>
                  <Button Classes="Icon" Width="26" Height="26" ToolTip.Tip="没帮助"
                          Classes.selected="{Binding IsDisliked}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DislikeMessageCommand}"
                          CommandParameter="{Binding}">
                    <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.ThumbDown}" />
                  </Button>
                  <Button Classes="Icon" Width="26" Height="26" ToolTip.Tip="重新生成"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RegenerateMessageCommand}"
                          CommandParameter="{Binding}">
                    <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Refresh}" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ListBox Grid.Row="2" Name="TraceList" Classes="MessageList" IsVisible="{Binding IsTraceTab}"
             ItemsSource="{Binding TraceView}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TraceItemViewModel">
            <Border Classes="Msg" Background="Transparent">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                  <TextBlock Text="{Binding Time}" Classes="Tertiary" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Margin="8,0" Padding="6,1" CornerRadius="999"
                          Background="{DynamicResource Brush.Accent.Soft}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KindLabel}" Classes="Tertiary" />
                  </Border>
                  <Button Grid.Column="2" Classes="TraceItem" Padding="6,2"
                          Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectTraceItemCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Title}" Classes="Secondary" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <Button Grid.Column="3" Classes="Icon" Width="22" Height="22" IsVisible="{Binding HasDetail}"
                          Command="{Binding ToggleExpandCommand}">
                    <TextBlock Text="{Binding ExpandLabel}" Classes="Tertiary" />
                  </Button>
                </Grid>
                <TextBlock Text="{Binding Detail}" Classes="Tertiary" Margin="0,2,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding IsExpanded}" />
              </StackPanel>
            </Border>
          </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="3" Margin="20,10,20,6" Padding="12,10"
            Background="{DynamicResource Brush.Bg.Card}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadius.Card}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto">
        <Border Grid.Row="0" Margin="0,0,0,6" MaxHeight="240" IsVisible="{Binding IsSuggestionOpen}"
                Background="{DynamicResource Brush.Bg.Inset}" CornerRadius="8">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Suggestions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SuggestionViewModel">
                  <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ConfirmSuggestionCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding Label}" Classes="Mono" />
                      <TextBlock Grid.Column="1" Text="{Binding Description}" Classes="Tertiary"
                                 Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" Margin="0,0,0,6">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AttachmentViewModel">
              <Border Background="{DynamicResource Brush.Bg.Inset}" CornerRadius="6" Padding="4" ToolTip.Tip="双击预览">
                <Grid ColumnDefinitions="Auto,Auto">
                  <Image Width="48" Height="48" Stretch="Uniform"
                         Source="{Binding Png, Converter={StaticResource PngToBitmap}}"
                         DoubleTapped="OnAttachmentDoubleTapped" />
                  <Button Grid.Column="1" Classes="Ghost" Width="18" Height="18" Padding="0"
                          VerticalAlignment="Top" Content="×"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveAttachmentCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox Grid.Row="2" Name="InputBox" Classes="Bare" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="40" MaxHeight="180"
                 PlaceholderText="{Binding Composer.Placeholder}"
                 Text="{Binding Composer.Input}" />

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,8,0,0">
          <Button Classes="Chip" ToolTip.Tip="附件与引用">
            <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Attach}" />
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft">
                <MenuItem Header="添加文件…" Command="{Binding AttachFileCommand}" />
                <MenuItem Header="添加文件夹…" Command="{Binding AttachFolderCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="1" Classes="Chip" Margin="6,0,0,0" ToolTip.Tip="引用历史会话">
            <TextBlock Text="@ 会话" />
            <Button.Flyout>
              <Flyout Placement="Top">
                <ListBox ItemsSource="{Binding RecentSessions}" MaxHeight="260" MinWidth="260">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionNodeViewModel">
                      <Button Classes="SessionItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).InsertMentionCommand}"
                              CommandParameter="{Binding SessionId.Value}">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </Button>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="2" Classes="Chip" Margin="6,0,0,0" ToolTip.Tip="权限">
            <TextBlock Text="{Binding Composer.PermissionLabel}" />
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft">
                <MenuItem Header="Ask（每次审批）" Command="{Binding SetPermissionCommand}" CommandParameter="ask" />
                <MenuItem Header="Full access（自动放行）" Command="{Binding SetPermissionCommand}" CommandParameter="full" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="3" Classes="Chip" Margin="6,0,0,0" ToolTip.Tip="模型">
            <TextBlock Text="{Binding Composer.ModelLabel}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
            <Button.Flyout>
              <Flyout Placement="Top" Opened="OnModelFlyoutOpened">
                <StackPanel Width="300" Spacing="6">
                  <TextBox Classes="Search" PlaceholderText="搜索模型"
                           Text="{Binding ModelSearchText}" />
                  <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredModels}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModelListItem">
                          <Button Classes="Ghost" Classes.selected="{Binding IsCurrent}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Click="OnModelItemClick">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="4" Classes="Chip" Margin="6,0,0,0" ToolTip.Tip="推理强度">
            <TextBlock Text="{Binding Composer.ReasoningLabel}" />
            <Button.Flyout>
              <Flyout Placement="Top" Opened="OnReasoningFlyoutOpened">
                <StackPanel Width="200" Spacing="4">
                  <TextBlock Text="当前模型不支持推理强度" Opacity="0.6" IsVisible="{Binding !HasReasoningEfforts}" />
                  <ItemsControl ItemsSource="{Binding Preferences.ReasoningEfforts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="sys:String">
                        <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnReasoningItemClick">
                          <TextBlock Text="{Binding}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="5" Classes="Chip" Margin="6,0,0,0" ToolTip.Tip="会话操作">
            <TextBlock Text="会话操作" />
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft">
                <MenuItem Header="压缩上下文（/compact）" Command="{Binding CompactCommand}" />
                <MenuItem Header="重载 MCP（/mcp）" Command="{Binding ReloadMcpCommand}" />
                <MenuItem Header="刷新模型列表" Command="{Binding RefreshModelsCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBlock Grid.Column="6" Text="Enter 发送 · Shift+Enter 换行 · / 命令 · @ 引用" Classes="Tertiary"
                     VerticalAlignment="Center" Margin="10,0,0,0" />
          <Button Grid.Column="7" Classes="Send" Command="{Binding SubmitCommand}"
                  IsVisible="{Binding !IsBusy}"
                  IsEnabled="{Binding Composer.CanSubmit}"
                  ToolTip.Tip="发送 (Enter)">
            <Path Classes="Icon" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.OnAccent}"
                  Data="{StaticResource Icon.Send}" />
          </Button>
          <Button Grid.Column="7" Classes="Send" Command="{Binding CancelTaskCommand}"
                  IsVisible="{Binding IsBusy}"
                  ToolTip.Tip="停止">
            <Path Classes="Icon" Width="14" Height="14" Stroke="{DynamicResource Brush.Text.OnAccent}"
                  Data="{StaticResource Icon.Stop}" />
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.RowSpan="5" Background="#B0000000" IsVisible="{Binding IsPreviewOpen}" ZIndex="20"
            PointerPressed="OnPreviewOverlayPressed">
      <Image Source="{Binding PreviewAttachment.Png, Converter={StaticResource PngToBitmap}}"
             Stretch="Uniform" Margin="60" />
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="22,0,22,10" Spacing="8">
      <TextBlock Text="{Binding StatusText}" Classes="Tertiary" VerticalAlignment="Center" />
      <TextBlock Text="{Binding TokenStats.Rounds}" Classes="Tertiary" />
      <TextBlock Text="{Binding TokenStats.FirstToken}" Classes="Tertiary" />
      <TextBlock Text="{Binding TokenStats.TokensPerSecond}" Classes="Tertiary" />
      <TextBlock Text="{Binding TokenStats.Cache}" Classes="Tertiary" />
      <TextBlock Text="{Binding TokenStats.Totals}" Classes="Tertiary" />
      <TextBlock Text="{Binding TokenStats.Latency}" Classes="Tertiary" />
    </StackPanel>

    <Grid Grid.Row="0" Grid.RowSpan="5" IsVisible="{Binding Subagents.IsViewing}"
          Background="{DynamicResource Brush.Bg.Chat}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,14,20,0">
          <Button Classes="Ghost" VerticalAlignment="Center" Command="{Binding Subagents.CloseCommand}"
                  ToolTip.Tip="返回父会话">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.ChevronDown}" />
              <TextBlock Text="返回父会话" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0">
            <TextBlock Text="{Binding Subagents.Current.DisplayName}" Classes="Title"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subagents.Current.ModeLabel}" Classes="Tertiary" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="● 运行中" Foreground="{DynamicResource Brush.Status.Success}"
                       IsVisible="{Binding Subagents.Current.IsLive}" />
            <TextBlock Text="○ 已结束" Classes="Tertiary" IsVisible="{Binding !Subagents.Current.IsLive}" />
            <Border Padding="6,1" CornerRadius="999" Background="{DynamicResource Brush.Accent.Soft}">
              <TextBlock Text="只读" Classes="Tertiary" />
            </Border>
          </StackPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border.Subtle}" />

        <ListBox Grid.Row="1" Classes="MessageList" ItemsSource="{Binding Subagents.Viewing.Messages}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageViewModel">
              <Border Classes="Msg" Classes.user="{Binding IsUser}" HorizontalAlignment="{Binding Align}">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Role}" Classes="Tertiary" IsVisible="{Binding HasRole}" />
                  <TextBlock Text="{Binding Preview}" Classes="Secondary" IsVisible="{Binding ShowPreview}" />
                  <views:MarkdownView Text="{Binding Text}" IsVisible="{Binding ShowMarkdown}" />
                  <TextBlock Text="{Binding Text}" Classes="Body" IsVisible="{Binding ShowPlainBody}" />
                  <TextBlock Text="{Binding Detail}" Classes="Body" IsVisible="{Binding ShowDetail}"
                             FontFamily="{DynamicResource Font.Mono}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="20,8,20,12">
          <Button Classes="Chip" Command="{Binding Subagents.PreviousCommand}"
                  IsEnabled="{Binding Subagents.CanPrevious}">
            <TextBlock Text="← 上一个" />
          </Button>
          <TextBlock Text="{Binding Subagents.PositionText}" Classes="Tertiary" VerticalAlignment="Center" />
          <Button Classes="Chip" Command="{Binding Subagents.NextCommand}"
                  IsEnabled="{Binding Subagents.CanNext}">
            <TextBlock Text="下一个 →" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
