<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dsh.Gui.ViewModels"
             x:Class="Dsh.Gui.Views.SidebarView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True"
             FontFamily="{DynamicResource Font.Ui}">

  <DockPanel Background="{DynamicResource Brush.Bg.Sidebar}">

    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,4" Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
          <Image Source="avares://Dsh.Gui/Assets/icon.png" Width="22" Height="22" />
        </Border>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="deepseek" FontSize="{DynamicResource FontSize.Brand}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Primary}" />
          <TextBlock Text="HARNESS" Classes="Tertiary" />
        </StackPanel>
        <Button Grid.Column="2" Classes="Icon" Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="折叠左栏" VerticalAlignment="Center">
          <Path Classes="Icon" Data="{StaticResource Icon.Collapse}" />
        </Button>
      </Grid>

      <Button Classes="Primary" HorizontalAlignment="Stretch" Command="{Binding NewSessionCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="Icon" Stroke="{DynamicResource Brush.Text.OnAccent}" Data="{StaticResource Icon.Plus}" />
          <TextBlock Text="新会话" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
        <Button Grid.Column="0" Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4"
                Command="{Binding ShowChatCommand}" ToolTip.Tip="{Binding CurrentWorkspace}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Folder}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentWorkspace}" Classes="Secondary" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="Icon" Width="26" Height="26" ToolTip.Tip="切换新会话默认工作区" VerticalAlignment="Center">
          <Path Classes="Icon" Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="360" Spacing="4">
                <TextBlock Text="最近工作区（点击设为新会话默认目录）" Classes="Secondary" Margin="4,0,0,2" />
                <ItemsControl ItemsSource="{Binding RecentWorkspaces}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceChoiceViewModel">
                      <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"
                              Command="{Binding SelectCommand}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding Path}" Classes="Tertiary" FontSize="{DynamicResource FontSize.Status}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="4,4" />
                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"
                        Content="打开新工作区…" Command="{Binding PickWorkspaceCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,2,0,0">
        <Button Classes="Chip" HorizontalAlignment="Left" ToolTip.Tip="工作区视图">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding WorkspaceViewLabel}" />
            <Path Classes="Icon" Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="解决方案视图" Command="{Binding SetWorkspaceViewCommand}" CommandParameter="solution" />
              <MenuItem Header="文件系统视图" Command="{Binding SetWorkspaceViewCommand}" CommandParameter="filesystem" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="1" Classes="Icon" Width="26" Height="26" Command="{Binding RefreshSessionsCommand}"
                ToolTip.Tip="刷新会话列表">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Refresh}" />
        </Button>
        <Button Grid.Column="2" Classes="Icon" Width="26" Height="26" ToolTip.Tip="排序">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Sort}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="按更新时间排序" Command="{Binding SetSortCommand}" CommandParameter="updated" />
              <MenuItem Header="按名称排序" Command="{Binding SetSortCommand}" CommandParameter="name" />
              <MenuItem Header="只看有会话的" ToggleType="CheckBox" IsChecked="{Binding OnlyWithSessions, Mode=TwoWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="3" Classes="Icon" Width="26" Height="26" ToolTip.Tip="搜索会话内容"
                Classes.selected="{Binding IsSearchOpen}" Command="{Binding ToggleSearchCommand}">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Search}" />
        </Button>
        <Button Grid.Column="4" Classes="Icon" Width="26" Height="26" ToolTip.Tip="新建会话" Command="{Binding NewSessionCommand}">
          <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Plus}" />
        </Button>
      </Grid>

      <TextBox Classes="Search" PlaceholderText="搜索会话内容" IsVisible="{Binding IsSearchOpen}" Text="{Binding SearchText}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,8" Spacing="2">
      <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Classes.selected="{Binding IsDashboardPage}" Command="{Binding ShowDashboardCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="Icon" Data="{StaticResource Icon.Dashboard}" />
          <TextBlock Text="工作台" VerticalAlignment="Center" />
          <Border Classes="AttentionBadge" IsVisible="{Binding Workspace.Dashboard.HasAttention}">
            <TextBlock Text="{Binding Workspace.Dashboard.AttentionCount}" />
          </Border>
        </StackPanel>
      </Button>
      <ItemsControl ItemsSource="{Binding Workspace.Pages.Available}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkspacePageEntry">
            <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowWorkspacePageCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="Icon" Data="{Binding Icon}" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding ShowMarketCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="Icon" Data="{StaticResource Icon.Plugin}" />
          <TextBlock Text="插件市场" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding ShowSettingsCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="Icon" Data="{StaticResource Icon.Settings}" />
          <TextBlock Text="设置" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <Grid>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="6,0,8,0" IsVisible="{Binding IsSolutionView}">
        <StackPanel Spacing="4">
        <TextBlock Text="最近会话" Classes="Tertiary" Margin="6,4,0,0" />
        <ItemsControl ItemsSource="{Binding Workspace.Dashboard.RecentCards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionCardViewModel">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="SessionItem" Classes.selected="{Binding IsCurrent}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5"
                        IsVisible="{Binding !IsRenaming}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Workspace.Dashboard.OpenCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes="Body" FontSize="{DynamicResource FontSize.List}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="Tertiary" FontSize="{DynamicResource FontSize.Status}"
                               TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Machine}" />
                      <Run Text=" · " />
                      <Run Text="{Binding ProjectName}" />
                    </TextBlock>
                  </StackPanel>
                </Button>
                <ContentControl Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding RenameEditor}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SessionCardViewModel">
                      <TextBox Classes="Search" Text="{Binding RenameDraft}"
                               AttachedToVisualTree="OnCardRenameAttached"
                               KeyDown="OnCardRenameKeyDown" LostFocus="OnCardRenameLostFocus" />
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
                <Button Grid.Column="1" Classes="Icon" Width="24" Height="24" ToolTip.Tip="更多"
                        VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}"
                        Click="OnRecentSessionMenuClick">
                  <Path Classes="Icon" Width="14" Height="14" Data="{StaticResource Icon.Menu}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="Ghost" Margin="6,4,0,0" HorizontalAlignment="Left" Padding="6,2"
                Command="{Binding ShowDashboardCommand}" Content="在工作台查看全部会话" />
        </StackPanel>
      </ScrollViewer>

      <TreeView x:Name="FileTree" ItemsSource="{Binding FileSystemNodes}" IsVisible="{Binding IsFileSystemView}"
                Background="Transparent" Padding="6,0,8,0">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:WorkspaceNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:WorkspaceNodeViewModel" ItemsSource="{Binding Children}">
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding Header}" Classes="Secondary" />
              <ItemsControl ItemsSource="{Binding Sessions}" Margin="10,0,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionNodeViewModel">
                    <Button Classes="SessionItem" Classes.selected="{Binding IsSelected}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSessionCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="●" FontSize="{DynamicResource FontSize.Status}"
                                     Foreground="{DynamicResource Brush.Status.Success}" VerticalAlignment="Center"
                                     IsVisible="{Binding IsRunning}" />
                          <TextBlock Text="{Binding Title}" Classes="Body" FontSize="{DynamicResource FontSize.List}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding MatchSnippet}" Classes="Tertiary" FontSize="{DynamicResource FontSize.Status}"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasMatchSnippet}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>
  </DockPanel>
</UserControl>
