<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dsh.Gui.ViewModels"
             x:Class="Dsh.Gui.Views.MarketPageView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True"
             FontFamily="{DynamicResource Font.Ui}">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource Brush.Bg.Chat}">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
          Classes="pageHeader" Classes.collapsed="{Binding !IsSidebarVisible}">
      <StackPanel Spacing="2">
        <TextBlock Text="插件市场" Classes="Title" />
        <TextBlock Text="{Binding MarketStatus}" Classes="Tertiary" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="Ghost" VerticalAlignment="Center" Content="刷新"
              Command="{Binding Preferences.RefreshPluginsCommand}" IsEnabled="{Binding !Preferences.IsWorking}" />
    </Grid>

    <ScrollViewer Grid.Row="1" Classes="Slim" Padding="20,0,20,8">
      <StackPanel Spacing="12">

        <Border Background="{DynamicResource Brush.Bg.Card}" CornerRadius="{DynamicResource CornerRadius.Card}" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Text="安装插件" Classes="Secondary" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding Preferences.PluginInput}" PlaceholderText="包名或插件库路径，例如 ./build/MyPlugin.dll" />
              <Button Grid.Column="1" Classes="Icon" Width="30" Height="30"
                      Command="{Binding Preferences.BrowsePluginPathCommand}" IsEnabled="{Binding !Preferences.IsWorking}"
                      ToolTip.Tip="浏览并选择插件文件">
                <Path Classes="Icon" Data="{StaticResource Icon.Folder}" />
              </Button>
              <Button Grid.Column="2" Classes="Primary" Margin="2,0,0,0" Content="安装"
                      Command="{Binding Preferences.AddPluginCommand}" IsEnabled="{Binding !Preferences.IsWorking}" />
            </Grid>
            <TextBlock Text="从本地插件库（.dll/.so/.dylib）或包名安装；启用/禁用立即写入 settings.yaml。" Classes="Tertiary" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource Brush.Bg.Card}" CornerRadius="{DynamicResource CornerRadius.Card}" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Text="已安装插件" Classes="Secondary" />
            <ItemsControl ItemsSource="{Binding Preferences.Plugins}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginRowViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Package}" Classes="Mono" />
                      <TextBlock Text="{Binding Description}" Classes="Tertiary" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="读" IsChecked="{Binding CanRead, Mode=TwoWay}" ToolTip.Tip="permissions.read" />
                        <CheckBox Content="写" IsChecked="{Binding CanWrite, Mode=TwoWay}" ToolTip.Tip="permissions.write" />
                        <CheckBox Content="网络" IsChecked="{Binding CanNetwork, Mode=TwoWay}" ToolTip.Tip="permissions.network" />
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="8,0" Padding="8,2" CornerRadius="999"
                            Background="{DynamicResource Brush.Accent.Soft}" VerticalAlignment="Center">
                      <Panel>
                        <TextBlock Text="已启用" Classes="Tertiary" IsVisible="{Binding Enabled}" />
                        <TextBlock Text="已禁用" Classes="Tertiary" IsVisible="{Binding !Enabled}" />
                      </Panel>
                    </Border>
                    <Button Grid.Column="2" Classes="Ghost" VerticalAlignment="Center"
                            Content="{Binding ActionLabel}"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Preferences.PluginActionCommand}"
                            CommandParameter="{Binding WireAction}" />
                    <Button Grid.Column="3" Classes="Ghost" VerticalAlignment="Center" Content="移除"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Preferences.PluginActionCommand}"
                            CommandParameter="{Binding RemoveAction}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="权限变更立即保存到 Host 的 settings.yaml。沙箱开启时，权限开关约束宿主中介操作，不限制 Host 插件的直接进程内访问。外部完整 Context 插件可在 YAML 中设置 execution: host，此角色具有完整进程内信任。插件参数在「设置 → 插件与 MCP」中查看。" Classes="Tertiary" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{Binding Preferences.Status}" Classes="Tertiary"
               Margin="20,0,20,10" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
