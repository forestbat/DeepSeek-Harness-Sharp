<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Dsh.Plugins.Generator\DshPluginPackage.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dsh.Transport\Dsh.Transport.csproj" />
    <ProjectReference Include="..\Dsh.Interaction\Dsh.Interaction.csproj" />
    <ProjectReference Include="..\Dsh.Fleet\Dsh.Fleet.csproj" />
    <ProjectReference Include="..\Dsh.RemoteHost.Client\Dsh.RemoteHost.Client.csproj" />
    <ProjectReference Include="..\Dsh.Boot\Dsh.Boot.csproj" />
    <ProjectReference Include="..\Dsh.Plugins.Abstractions\Dsh.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\Dsh.Runtime\Dsh.Runtime.csproj" />
  </ItemGroup>

  <!--
    The browser front end is plain HTML/CSS/JS under wwwroot, embedded as manifest resources so that trimmed and NativeAOT builds serve it without loose files.
    Logical names keep the relative path (wwwroot/<path>); StaticAssets normalises Windows separators.
  -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
