<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Dsh.Plugins.Generator\DshPluginHost.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <ApplicationId>ai.dsh.mobile</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.4.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- 侧载安装(文件管理器点开 APK)不会走 fast deployment, 程序集必须打进 APK 才能独立启动。 -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <_JdkFromLocal Condition="Exists('$(LOCALAPPDATA)\Microsoft')">$([System.IO.Directory]::GetDirectories('$(LOCALAPPDATA)\Microsoft', 'jdk-21*'))</_JdkFromLocal>
    <_JdkFromProgramFiles Condition="Exists('$(ProgramFiles)\Microsoft')">$([System.IO.Directory]::GetDirectories('$(ProgramFiles)\Microsoft', 'jdk-21*'))</_JdkFromProgramFiles>
  </PropertyGroup>

  <!-- JDK/Android SDK 自动发现: IDE 直接打开 slnx 时没有命令行 -p 参数, 找不到 JDK 会让整个项目加载失败。 -->
  <PropertyGroup Condition="'$(JavaSdkDirectory)' == '' and '$(JAVA_HOME)' != '' and Exists('$(JAVA_HOME)\bin\javac.exe')">
    <JavaSdkDirectory>$(JAVA_HOME)</JavaSdkDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JavaSdkDirectory)' == '' and '$(_JdkFromLocal)' != ''">
    <JavaSdkDirectory>$([System.String]::Copy('$(_JdkFromLocal)').Split(';')[0])</JavaSdkDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JavaSdkDirectory)' == '' and '$(_JdkFromProgramFiles)' != ''">
    <JavaSdkDirectory>$([System.String]::Copy('$(_JdkFromProgramFiles)').Split(';')[0])</JavaSdkDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">
    <AndroidSdkDirectory>$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本机 host 首次启动要用它生成 settings.yaml; 桌面端靠 Content 拷到输出目录, APK 里只能以资源形式随包。 -->
    <AndroidAsset Include="..\Dsh.Boot\Profiles\Templates\settings.yaml" Link="Profiles\Templates\settings.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dsh.Boot\Dsh.Boot.csproj" />
    <ProjectReference Include="..\Dsh.Core\Dsh.Core.csproj" />
    <ProjectReference Include="..\Dsh.Gui.Shared\Dsh.Gui.Shared.csproj" />
    <ProjectReference Include="..\..\Dsh.Host\Dsh.Host.csproj" />
    <ProjectReference Include="..\Dsh.Llm\Dsh.Llm.csproj" />
    <ProjectReference Include="..\Dsh.RemoteHost.Server\Dsh.RemoteHost.Server.csproj" />
    <ProjectReference Include="..\Dsh.RemoteHost.Client\Dsh.RemoteHost.Client.csproj" />
  </ItemGroup>

</Project>
