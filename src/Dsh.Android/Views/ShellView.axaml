<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dsh.Android.ViewModels"
             xmlns:gui="using:Dsh.Gui.ViewModels"
             x:Class="Dsh.Android.Views.ShellView"
             x:DataType="vm:MobileShellViewModel"
             x:CompileBindings="True"
             Background="#111317">

  <UserControl.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#8B929C" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#F28B82" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="Background" Value="#1B1E24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="12,4" />
    </Style>
    <Style Selector="Border.message.user">
      <Setter Property="Background" Value="#20364D" />
    </Style>
    <Style Selector="Border.message.tool">
      <Setter Property="Background" Value="#2B2519" />
    </Style>
    <Style Selector="Border.message.result">
      <Setter Property="Background" Value="#1D2620" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1B1E24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="12,5" />
    </Style>
    <Style Selector="TextBlock.role">
      <Setter Property="Foreground" Value="#8B929C" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.active">
      <Setter Property="Background" Value="#2D6CDF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="#171A1F" Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0"
                Content="←"
                FontSize="18"
                Padding="12,4"
                Margin="0,0,10,0"
                Command="{Binding BackCommand}"
                IsVisible="{Binding ShowChat}" />
        <Button Grid.Column="0"
                Content="←"
                FontSize="18"
                Padding="12,4"
                Margin="0,0,10,0"
                Command="{Binding CancelMachineCommand}"
                IsVisible="{Binding ShowConnect}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="DSH" FontSize="17" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8B929C" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2"
                Content="＋"
                FontSize="18"
                Padding="12,4"
                Command="{Binding AddMachineCommand}"
                IsVisible="{Binding ShowMachines}" />
        <Button Grid.Column="2"
                Content="机器"
                Padding="12,4"
                Command="{Binding OpenMachinesCommand}"
                IsVisible="{Binding ShowSessions}" />
      </Grid>
    </Border>

    <!-- 机器列表 + 手机工具 -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowMachines}">
      <StackPanel Margin="0,4,0,20">
        <TextBlock Margin="16,10,16,2" Text="机器" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Margin="16,0,16,4" Classes="hint" Text="每台机器各有一条连接；切到会话页可以同时看到所有机器上的会话。" />
        <TextBlock Margin="16,0,16,4" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <ItemsControl ItemsSource="{Binding Machines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MachineRowViewModel">
              <Border Classes="card">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Target}" Classes="hint" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8B929C" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding SessionSummary}" FontSize="11" Foreground="#5F6672" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="error" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="small"
                            Content="连接"
                            IsVisible="{Binding CanConnect}"
                            Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).AttachMachineCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="small"
                            Content="断开"
                            IsVisible="{Binding IsConnected}"
                            Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).DetachMachineCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="small"
                            Content="查看会话"
                            IsVisible="{Binding IsConnected}"
                            Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).AttachMachineCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="small"
                            Content="编辑"
                            Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).EditMachineCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="small"
                            Content="删除"
                            Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).RemoveMachineCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="16,10,16,0" Classes="hint"
                   Text="还没有机器。点右上角 ＋ 填写一台桌面机的地址，保存后会立即连接。"
                   IsVisible="{Binding HasNoMachines}" />

        <Border Classes="card" Background="#141A22" Margin="12,18,12,5">
          <StackPanel Spacing="8">
            <TextBlock Text="本机 agent" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Classes="hint"
                       Text="在手机上直接跑一个宿主：会话与工具都在本机执行，不需要连电脑。" />
            <TextBox PlaceholderText="供应商，例如 deepseek" Text="{Binding LocalProvider}" />
            <TextBox PlaceholderText="模型，例如 deepseek-chat" Text="{Binding LocalModel}" />
            <TextBox PlaceholderText="接口地址，留空则用供应商默认地址" Text="{Binding LocalBaseUrl}" />
            <TextBox PlaceholderText="API 密钥" Text="{Binding LocalApiKey}" PasswordChar="●" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="启动" Command="{Binding StartLocalCommand}" />
              <Button Content="停止" Command="{Binding StopLocalCommand}" IsVisible="{Binding LocalRunning}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Background="#141A22" Margin="12,18,12,5">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="手机工具（MCP）" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="把手机本身的能力（列应用、启动应用、打开链接）暴露给电脑上的 agent。" />
              </StackPanel>
              <Button Grid.Column="1" Classes="small"
                      Content="{Binding PhoneToolsToggleLabel}"
                      Command="{Binding TogglePhoneToolsCommand}" />
            </Grid>
            <TextBlock Classes="hint" Text="在电脑的 settings.yaml 里加：" IsVisible="{Binding PhoneToolsEnabled}" />
            <TextBox Text="{Binding PhoneToolsUrl}" IsReadOnly="True" FontSize="12" TextWrapping="Wrap" MaxHeight="90"
                     IsVisible="{Binding PhoneToolsEnabled}" />
            <Button Content="复制地址" Classes="small" HorizontalAlignment="Stretch" Click="OnCopyPhoneToolsUrl"
                    IsVisible="{Binding PhoneToolsEnabled}" />
            <TextBlock Classes="hint" IsVisible="{Binding PhoneToolsEnabled}"
                       Text="mcpServers:&#10;  phone:&#10;    transport: streamable-http&#10;    url: 上面的地址" />
            <TextBlock Classes="error" Text="{Binding PhoneToolsError}" IsVisible="{Binding HasPhoneToolsError}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 添加/编辑一台机器 -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowConnect}">
      <StackPanel Margin="20,28" Spacing="12" MaxWidth="520">
        <TextBlock Text="添加桌面机" FontSize="20" FontWeight="SemiBold" />
        <TextBox PlaceholderText="机器名，例如 工作站" Text="{Binding MachineName}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="TCP" Command="{Binding UseTcpTransportCommand}" Classes.active="{Binding UseTcp}" />
          <Button Content="SSH" Command="{Binding UseSshTransportCommand}" Classes.active="{Binding UseSsh}" />
        </StackPanel>
        <TextBlock Classes="hint"
                   IsVisible="{Binding UseTcp}"
                   Text="在电脑上运行 dsharp host serve --listen 0.0.0.0:47321 --token &lt;令牌&gt;，把这里的主机、端口和令牌填成一样。" />
        <TextBlock Classes="hint"
                   IsVisible="{Binding UseSsh}"
                   Text="SSH 会经端口转发连到桌面机已运行的 dsharp host serve；令牌填它的 --token，公钥需先加入桌面机。" />
        <TextBox PlaceholderText="主机，例如 192.168.1.3" Text="{Binding Host}" />
        <TextBox PlaceholderText="端口，例如 47321" Text="{Binding PortText}" />
        <StackPanel Spacing="8" IsVisible="{Binding UseSsh}">
          <TextBox PlaceholderText="SSH 用户名" Text="{Binding SshUser}" />
          <TextBlock Classes="hint"
                     Text="把下面的公钥追加到桌面机的 authorized_keys；管理员账号用 C:\ProgramData\ssh\administrators_authorized_keys。" />
          <TextBox Text="{Binding PublicKeyLine}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" />
          <Button Content="复制公钥" Click="OnCopyPublicKey" HorizontalAlignment="Stretch" />
        </StackPanel>
        <TextBox PlaceholderText="访问令牌" Text="{Binding Token}" PasswordChar="●" />
        <Button Content="保存并连接" Command="{Binding SaveMachineCommand}" HorizontalAlignment="Stretch" />
        <Button Content="取消" Command="{Binding CancelMachineCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </ScrollViewer>

    <!-- 会话列表 -->
    <Grid Grid.Row="1" IsVisible="{Binding ShowSessions}" RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0" Margin="16,12,16,0" Text="{Binding SessionScope}" FontSize="16" FontWeight="SemiBold" />
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="12,6,12,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="small" Content="全部" Command="{Binding ShowAllMachinesCommand}" />
          <ItemsControl ItemsSource="{Binding Machines}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MachineRowViewModel">
                <Button Classes="small" Classes.active="{Binding IsSelected}" Content="{Binding Name}"
                        Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).SelectMachineCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Classes="error" Margin="16,4,16,0" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <ListBox Grid.Row="3"
               ItemsSource="{Binding Sessions}"
               SelectedItem="{Binding SelectedSession}"
               SelectionMode="Single"
               Background="Transparent"
               Margin="6,4,6,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SessionRowViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="6,6">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="hint" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8B929C" HorizontalAlignment="Right" />
                <TextBlock Text="待处理" FontSize="11" Foreground="#F2B94A" HorizontalAlignment="Right"
                           IsVisible="{Binding HasPending}" />
                <TextBlock Text="{Binding Activity}" FontSize="11" Foreground="#5F6672" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="12,6,12,16">
        <TextBox Grid.Column="0" PlaceholderText="新会话的工作目录，例如 /home/me/project"
                 Text="{Binding NewSessionCwd}" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="新建会话" Command="{Binding CreateSessionCommand}" />
      </Grid>
    </Grid>

    <!-- 会话内容 -->
    <Grid Grid.Row="1" IsVisible="{Binding ShowChat}" RowDefinitions="Auto,*,Auto,Auto,Auto">
      <StackPanel Grid.Row="0" Margin="16,10,16,4" Spacing="2">
        <TextBlock Text="{Binding ChatTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ChatSubtitle}" Classes="hint" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" x:Name="MessageScroll">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="4,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="gui:MessageViewModel">
              <Border Classes="message"
                      Classes.user="{Binding IsUser}"
                      Classes.tool="{Binding IsTool}"
                      Classes.result="{Binding IsContext}">
                <StackPanel Spacing="3">
                  <TextBlock Classes="role" Text="{Binding Role}" />
                  <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Margin="12,4" Spacing="6">
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <Border Background="#2C2317" CornerRadius="12" Padding="12,10" IsVisible="{Binding HasApproval}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ApprovalTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#F2B94A" />
            <TextBlock Text="{Binding ApprovalDetail}" Classes="hint" MaxHeight="120" />
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" Content="拒绝" Command="{Binding DenyCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
              <Button Grid.Column="1" Content="允许" Command="{Binding AllowCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="#1A2432" CornerRadius="12" Padding="12,10" IsVisible="{Binding HasQuestions}">
          <ScrollViewer MaxHeight="320">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding QuestionTitle}" FontSize="14" FontWeight="SemiBold"
                         Foreground="#8AB4F8" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Questions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuestionItemViewModel">
                    <StackPanel Spacing="4" Margin="0,0,0,8">
                      <TextBlock Text="{Binding Question}" FontSize="14" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Classes="hint" IsVisible="{Binding HasDetail}" />
                      <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:QuestionOptionViewModel">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBox Text="{Binding Custom}" PlaceholderText="其他答案（可选）" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="提交回答" Command="{Binding SubmitAnswersCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <Border Grid.Row="3" Background="#1B1E24" CornerRadius="10" Padding="12,8" Margin="12,2"
              IsVisible="{Binding HasAttachment}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding AttachmentSummary}" Classes="hint" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="移除" Padding="10,2" MinHeight="32" Click="OnClearAttachment" />
        </Grid>
      </Border>

      <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="12,6,12,16">
        <Button Grid.Column="0" Content="＋" FontSize="18" Padding="14,4" Margin="0,0,8,0"
                VerticalAlignment="Bottom" Click="OnPickAttachment" />
        <TextBox Grid.Column="1"
                 Text="{Binding Input}"
                 PlaceholderText="发送消息…"
                 AcceptsReturn="True"
                 MaxHeight="120"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Center"
                 Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}" VerticalAlignment="Bottom" />
      </Grid>
    </Grid>

  </Grid>
</UserControl>
