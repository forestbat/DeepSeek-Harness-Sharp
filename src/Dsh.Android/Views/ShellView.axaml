<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dsh.Android.ViewModels"
             xmlns:gui="using:Dsh.Gui.ViewModels"
             x:Class="Dsh.Android.Views.ShellView"
             x:DataType="vm:MobileShellViewModel"
             x:CompileBindings="True"
             Background="#111317">

  <UserControl.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#8B929C" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#F28B82" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="Background" Value="#1B1E24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="12,4" />
    </Style>
    <Style Selector="Border.message.user">
      <Setter Property="Background" Value="#20364D" />
    </Style>
    <Style Selector="Border.message.tool">
      <Setter Property="Background" Value="#2B2519" />
    </Style>
    <Style Selector="Border.message.result">
      <Setter Property="Background" Value="#1D2620" />
    </Style>
    <Style Selector="TextBlock.role">
      <Setter Property="Foreground" Value="#8B929C" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="#171A1F" Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0"
                Content="←"
                FontSize="18"
                Padding="12,4"
                Margin="0,0,10,0"
                Command="{Binding BackCommand}"
                IsVisible="{Binding ShowChat}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="DSH" FontSize="17" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8B929C" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2"
                Content="断开"
                Command="{Binding DisconnectCommand}"
                IsVisible="{Binding !ShowConnect}" />
      </Grid>
    </Border>

    <!-- 连接表单 -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowConnect}">
      <StackPanel Margin="20,28" Spacing="12" MaxWidth="520">
        <TextBlock Text="连接到电脑上的 DSH host" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Classes="hint"
                   Text="在电脑上运行 dsharp host serve --listen 0.0.0.0:47321 --token &lt;令牌&gt;，把这里的主机、端口和令牌填成一样。" />
        <TextBox PlaceholderText="主机，例如 192.168.1.3" Text="{Binding Host}" />
        <TextBox PlaceholderText="端口，例如 47321" Text="{Binding PortText}" />
        <TextBox PlaceholderText="访问令牌" Text="{Binding Token}" PasswordChar="●" />
        <Button Content="连接" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </ScrollViewer>

    <!-- 会话列表 -->
    <Grid Grid.Row="1" IsVisible="{Binding ShowSessions}" RowDefinitions="Auto,Auto,*">
      <TextBlock Grid.Row="0" Margin="16,14,16,6" Text="会话" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Classes="error" Margin="16,0,16,4" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <ListBox Grid.Row="2"
               ItemsSource="{Binding Sessions}"
               SelectedItem="{Binding SelectedSession}"
               SelectionMode="Single"
               Background="Transparent"
               Margin="6,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SessionRowViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="6,6">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="hint" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8B929C" HorizontalAlignment="Right" />
                <TextBlock Text="待处理" FontSize="11" Foreground="#F2B94A" HorizontalAlignment="Right"
                           IsVisible="{Binding HasPending}" />
                <TextBlock Text="{Binding Activity}" FontSize="11" Foreground="#5F6672" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- 会话内容 -->
    <Grid Grid.Row="1" IsVisible="{Binding ShowChat}" RowDefinitions="Auto,*,Auto,Auto,Auto">
      <StackPanel Grid.Row="0" Margin="16,10,16,4" Spacing="2">
        <TextBlock Text="{Binding ChatTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ChatSubtitle}" Classes="hint" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" x:Name="MessageScroll">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="4,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="gui:MessageViewModel">
              <Border Classes="message"
                      Classes.user="{Binding IsUser}"
                      Classes.tool="{Binding IsTool}"
                      Classes.result="{Binding IsContext}">
                <StackPanel Spacing="3">
                  <TextBlock Classes="role" Text="{Binding Role}" />
                  <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Margin="12,4" Spacing="6">
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <TextBlock Text="{Binding QuestionHint}"
                   Classes="hint"
                   Foreground="#F2B94A"
                   IsVisible="{Binding HasQuestion}" />
        <Border Background="#2C2317" CornerRadius="12" Padding="12,10" IsVisible="{Binding HasApproval}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ApprovalTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#F2B94A" />
            <TextBlock Text="{Binding ApprovalDetail}" Classes="hint" MaxHeight="120" />
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" Content="拒绝" Command="{Binding DenyCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
              <Button Grid.Column="1" Content="允许" Command="{Binding AllowCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Row="3" Background="#1B1E24" CornerRadius="10" Padding="12,8" Margin="12,2"
              IsVisible="{Binding HasAttachment}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding AttachmentSummary}" Classes="hint" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="移除" Padding="10,2" MinHeight="32" Click="OnClearAttachment" />
        </Grid>
      </Border>

      <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="12,6,12,16">
        <Button Grid.Column="0" Content="＋" FontSize="18" Padding="14,4" Margin="0,0,8,0"
                VerticalAlignment="Bottom" Click="OnPickAttachment" />
        <TextBox Grid.Column="1"
                 Text="{Binding Input}"
                 PlaceholderText="发送消息…"
                 AcceptsReturn="True"
                 MaxHeight="120"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Center"
                 Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}" VerticalAlignment="Bottom" />
      </Grid>
    </Grid>

  </Grid>
</UserControl>
