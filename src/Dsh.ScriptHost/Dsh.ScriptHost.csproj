<Project Sdk="Microsoft.NET.Sdk">

  <!--
    C# 工具调用程序的沙箱执行引擎: Roslyn 编译、同一可执行文件的脚本宿主子进程与 NDJSON 帧桥接。
    纯能力库, 不含插件入口; ptc 插件(run_code)与 workflow 插件共用, 宿主入口按 PtcScriptHost.HostArgument 派发到 PtcScriptHost。
  -->
  <ItemGroup>
    <ProjectReference Include="..\Dsh.Agent\Dsh.Agent.csproj" />
    <ProjectReference Include="..\Dsh.Subprocess\Dsh.Subprocess.csproj" />
    <ProjectReference Include="..\Dsh.Core\Dsh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
