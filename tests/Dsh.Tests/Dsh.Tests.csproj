<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\src\Dsh.Plugins.Generator\DshPluginHost.props" />

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1701</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DshBuildFaultProbe>true</DshBuildFaultProbe>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      热装载用例的磁盘载荷: 只取它的产物文件, 不在测试代码里引用它的类型。
      ReferenceOutputAssembly=false 是必须的: 本工程是宿主(DshPluginHost=true), 生成器会把"引用到的程序集"
      声明的 [DshPlugin] 一并聚合进编译目录, 直接引用会让夹具的 test/local 与测试自带的 TestPlugin 撞包。
      因此产物文件用下面的 None 显式复制。
    -->
    <ProjectReference Include="..\Dsh.ManagedPluginSample\Dsh.ManagedPluginSample.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\managed-plugin\DshPluginTemplate.csproj" ReferenceOutputAssembly="false" />
    <!-- 让 /plugins add 走与真实插件相同的 dll + deps 闭包路径。 -->
    <None Include="..\Dsh.ManagedPluginSample\bin\$(Configuration)\$(TargetFramework)\Dsh.ManagedPluginSample.dll"
          Link="Dsh.ManagedPluginSample.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Dsh.ManagedPluginSample\bin\$(Configuration)\$(TargetFramework)\Dsh.ManagedPluginSample.deps.json"
          Link="Dsh.ManagedPluginSample.deps.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- MCP 资源用例连接的真实 stdio server 进程: 测试经 dotnet 宿主启动这份 dll, 不引用它的类型。 -->
    <ProjectReference Include="..\Dsh.McpResourceServerSample\Dsh.McpResourceServerSample.csproj" ReferenceOutputAssembly="false" />
    <!--
      发布版 settings.yaml 模板: 内容文件不会穿过传递项目引用(Dsh.Boot 是经 Dsh.Host 间接引用的),
      而 SettingsTemplateTests 校验的正是"随包发布的这份", 所以显式复制, 避免它悄悄缺失。
    -->
    <None Include="..\..\src\Dsh.Boot\Profiles\Templates\settings.yaml"
          Link="Profiles\Templates\settings.yaml"
          CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="ScheduleUpstreamFixtures.json" LogicalName="Dsh.Tests.ScheduleUpstreamFixtures.json" />
    <None Update="NetworkGuiDriver.java" CopyToOutputDirectory="PreserveNewest" />
    <!-- Search API responses captured from the real GitHub and Stack Exchange APIs; the engine tests replay them through a local handler. -->
    <None Update="Web\ApiSamples\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

