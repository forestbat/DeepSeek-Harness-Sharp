  </ItemGroup>

  <!-- Keep the child executable's complete runtime closure separate from the test host's shared-framework dependencies. -->
  <Target Name="CopyMcpResourceServerRuntime" AfterTargets="Build">
    <ItemGroup>
      <_McpResourceServerRuntime Include="$(MSBuildProjectDirectory)/../Dsh.McpResourceServerSample/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_McpResourceServerRuntime)"
          DestinationFiles="@(_McpResourceServerRuntime->'$(TargetDir)mcp-resource-server/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- A standalone startup hook must not load the test assembly's plugin-registration module initializers into dsharp. -->
  <Target Name="BuildNetworkGuiObserver" AfterTargets="Build"
          Inputs="$(MSBuildProjectDirectory)/NetworkProxySmokeTests.cs;@(ReferencePath)"
          Outputs="$(TargetDir)network-gui-observer.dll">
    <Csc Sources="$(MSBuildProjectDirectory)/NetworkProxySmokeTests.cs"
         References="@(ReferencePath)"
         OutputAssembly="$(TargetDir)network-gui-observer.dll"
         TargetType="Library" DefineConstants="NETWORK_GUI_OBSERVER"
         Nullable="enable" LangVersion="$(LangVersion)"
         NoStandardLib="true" NoConfig="true" Deterministic="true"
         UseSharedCompilation="false" EmitDebugInformation="false" />
  </Target>

</Project>
