<Project Sdk="Microsoft.NET.Sdk">

  <!--
    打开性能基准的命令行入口: 参数一律走命令行(不做环境变量配置), 便于单独剖析冷/热两态。
    不进解决方案: 只在不定期复核打开性能时 build/run。
    用法见 Program.cs 顶部的注释。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Dsh.OpenBench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dsh.Agent\Dsh.Agent.csproj" />
    <ProjectReference Include="..\..\src\Dsh.Core\Dsh.Core.csproj" />
    <ProjectReference Include="..\..\src\Dsh.Persistence\Dsh.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Dsh.Runtime\Dsh.Runtime.csproj" />
  </ItemGroup>

</Project>
