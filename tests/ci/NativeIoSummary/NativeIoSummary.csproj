<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NativeStackDirectory Condition="'$(NativeStackDirectory)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/native-startup-stack/.store/dotnet-stack/10.0.750501/dotnet-stack/10.0.750501/tools/net8.0/any</NativeStackDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Diagnostics.Tracing.TraceEvent">
      <HintPath>$(NativeStackDirectory)/Microsoft.Diagnostics.Tracing.TraceEvent.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Diagnostics.FastSerialization">
      <HintPath>$(NativeStackDirectory)/Microsoft.Diagnostics.FastSerialization.dll</HintPath>
    </Reference>
    <None Include="$(NativeStackDirectory)/Dia2Lib.dll;$(NativeStackDirectory)/TraceReloggerLib.dll;$(NativeStackDirectory)/Microsoft.Diagnostics.NETCore.Client.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
