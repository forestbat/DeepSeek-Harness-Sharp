<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Dsh.Host\Dsh.Host.Publish.targets" />

    <!--
      控制台宿主(dsharp): 薄入口, 组合根与插件引用在 Dsh.Host 库中。
      命令名 dsharp 不与 apt 的 dsh(dancer's shell / distributed shell)重名。
      发布形态:默认 Release 为 JIT + partial 裁剪 + 自包含;AOT 属可选档,用 -p:PublishAot=true 命令行开启(见 README)。
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>dsharp</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>DeepSeek_Harness_Sharp</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <CETCompat>false</CETCompat>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Dsh.Host\Dsh.Host.csproj" />
    </ItemGroup>

    <!--
      settings.yaml 模板同步钩子:
      - 默认 verify: 校验生成块的键/默认值是否与配置面一致（说明注释不参与比较）;
      - -p:UpdateSettingsTemplate=true: 重写生成块（保留键上方的说明注释）。
      跑的是 SDK 生成的 apphost（Windows 为 dsharp.exe, Unix 为 dsharp）:
      $(TargetPath) 是托管 dll, 直接执行会崩; 所以 Build 与 Publish 各挂一次, 且要求可执行文件存在。
    -->
    <PropertyGroup>
      <SettingsTemplateFile>$(MSBuildThisFileDirectory)..\src\Dsh.Boot\Profiles\Templates\settings.yaml</SettingsTemplateFile>
      <SettingsTemplateMode Condition="'$(UpdateSettingsTemplate)' == 'true'">--write-template</SettingsTemplateMode>
      <SettingsTemplateMode Condition="'$(UpdateSettingsTemplate)' != 'true'">--verify</SettingsTemplateMode>
      <SettingsTemplateExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</SettingsTemplateExe>
    </PropertyGroup>

    <Target Name="SettingsTemplateHookBuild" AfterTargets="Build"
            Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(TargetDir)$(AssemblyName)$(SettingsTemplateExe)')">
      <Exec Command="&quot;$(TargetDir)$(AssemblyName)$(SettingsTemplateExe)&quot; config schema $(SettingsTemplateMode) --path &quot;$(SettingsTemplateFile)&quot;"
            WorkingDirectory="$(MSBuildThisFileDirectory).."
            ContinueOnError="false" />
    </Target>

    <Target Name="SettingsTemplateHookPublish" AfterTargets="Publish"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
      <PropertyGroup>
        <_SettingsTemplatePublishHost>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', '$(AssemblyName)$(SettingsTemplateExe)'))</_SettingsTemplatePublishHost>
      </PropertyGroup>
      <Exec Condition="Exists('$(_SettingsTemplatePublishHost)')"
            Command="&quot;$(_SettingsTemplatePublishHost)&quot; config schema $(SettingsTemplateMode) --path &quot;$(SettingsTemplateFile)&quot;"
            WorkingDirectory="$(MSBuildThisFileDirectory).."
            ContinueOnError="false" />
    </Target>

</Project>
