<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>DeepSeek_Harness_Sharp</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <CETCompat>false</CETCompat>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\src\Dsh.Core\Dsh.Core.csproj" />
      <ProjectReference Include="..\src\Dsh.Boot\Dsh.Boot.csproj" />
      <ProjectReference Include="..\src\Dsh.Llm\Dsh.Llm.csproj" />
      <ProjectReference Include="..\Cordis\Cordis.csproj" />
      <ProjectReference Include="..\src\Dsh.Sdk\Dsh.Sdk.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Terminal.Gui" Version="2.6.0-develop.61" />
    </ItemGroup>

    <Target Name="CopySurfaceAssemblies" AfterTargets="Build">
      <MSBuild Projects="..\src\Dsh.Tui\Dsh.Tui.csproj;..\src\Dsh.Acp\Dsh.Acp.csproj;..\src\Dsh.Lsp\Dsh.Lsp.csproj"
               Targets="Build"
               Properties="Configuration=$(Configuration)" />
      <ItemGroup>
        <SurfaceAssemblies Include="..\src\Dsh.Tui\bin\$(Configuration)\net10.0\*.dll" />
        <SurfaceAssemblies Include="..\src\Dsh.Acp\bin\$(Configuration)\net10.0\*.dll" />
        <SurfaceAssemblies Include="..\src\Dsh.Lsp\bin\$(Configuration)\net10.0\*.dll" />
      </ItemGroup>
      <Copy SourceFiles="@(SurfaceAssemblies)"
            DestinationFolder="$(OutDir)"
            SkipUnchangedFiles="true" />
    </Target>

</Project>
