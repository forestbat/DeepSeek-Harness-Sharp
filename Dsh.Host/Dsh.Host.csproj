<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\src\Dsh.Plugins.Generator\DshPluginHost.props" />

  <!--
    入口组合根: CLI 参数解析与插件组合(ConfigBoot)的宿主逻辑。
    控制台宿主(DeepSeek-Harness-Sharp)与 GUI 宿主(DshGuiHost)以薄入口分别引用本库。
    exe 直接引用 exe 会触发 .NET 的 SelfContained 一致性校验导致 Release 构建失败, 抽库后两个 exe 的发布形态各自独立。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Dsh.Boot\Dsh.Boot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Dsh.*\*.csproj"
                      Exclude="..\src\Dsh.Boot\Dsh.Boot.csproj;..\src\Dsh.Plugins.Abstractions\Dsh.Plugins.Abstractions.csproj;..\src\Dsh.Plugins.Host\Dsh.Plugins.Host.csproj;..\src\Dsh.Plugins.Generator\Dsh.Plugins.Generator.csproj" />
  </ItemGroup>

</Project>
